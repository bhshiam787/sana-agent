# Copy to agent/.env and fill in. The database URL is read from web/.env.

# Tamanna's Gmail. App password: Google Account → Security → 2-Step Verification (must be on)
# → App passwords → create one named "Sana Agent". Paste the 16 letters (spaces are fine).
GMAIL_USER="tamannazubairisana@gmail.com"
GMAIL_APP_PASSWORD=""
SENDER_NAME="Tamanna Zubairi Sana"

# Dashboard login email of whoever starts the run (shown as "started by").
RUN_AS=""

# Limits
NIGHTLY_EMAIL_CAP=20
PROFILE_PER_RUN=40
SHORTLIST_MIN_PRIORITY=60
SEND_GAP_MIN=4
SEND_GAP_MAX=11
FOLLOW_UP_DAYS=12

# LinkedIn (read-only browsing with the separate account). Run `pnpm linkedin:login` once first.
LINKEDIN_ENABLED=0
LINKEDIN_MAX_PAGES=40

# Polite contact for the OpenAlex API (faster, recommended)
OPENALEX_MAILTO="tamannazubairisana@gmail.com"

# CLAUDE_MODEL="claude-opus-5-5"

# Claude sessions at once (finders, profiler, deep research, writer)
# PARALLEL=  (overrides the mode: economy 5, max 16)

# Free key from https://openalex.org/settings/api (without it OpenAlex shares a tiny daily budget)
OPENALEX_API_KEY=""

# Hours to keep finding/researching/writing; sending continues until the nightly cap
RUN_HOURS=8

# Stop starting new work when the Claude 5-hour usage window reaches this percent
USAGE_STOP_PERCENT=85
# 1 = pause until the 5-hour window resets, then continue; 0 = end the run instead
RESUME_AFTER_RESET=1

# economy (default: Sonnet for bulk work, 5 parallel, per-run caps) or max (all Opus, 16 parallel, no caps)
AGENT_MODE=economy
